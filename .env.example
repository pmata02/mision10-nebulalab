# Copiar a .env solo si se utiliza Gemini. NO subir .env al repositorio.
GEMINI_API_KEY=
# Modelo de generación disponible en vuestro proyecto (comprobad nombre y cuotas en AI Studio)
GEMINI_MODEL=gemini-3.5-flash-lite
# Segundos máximos de espera por llamada antes de reintentar
GEMINI_TIMEOUT_S=60
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Configuración por defecto de index/ask: kit | R0b | R1 | R2a | R2 | R3 | opt_sin_glosario | optimizada | gemini_emb
RAG_CONFIG=optimizada
# tfidf (offline) o gemini: con "gemini", la config optimizada usa embeddings de Gemini
EMBEDDING_BACKEND=tfidf
